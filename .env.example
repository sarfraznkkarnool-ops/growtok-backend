# Copy to .env for local dev. On Replit, set these as Secrets instead —
# don't commit real values.

MONGODB_URL=mongodb://localhost:27017
# or a MongoDB Atlas connection string:
# MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Set to "true" only for local dev — it disables the startup check that
# refuses to boot without a strong JWT_SECRET. Leave "false" (or unset) in
# any deployed environment.
DEBUG=true
